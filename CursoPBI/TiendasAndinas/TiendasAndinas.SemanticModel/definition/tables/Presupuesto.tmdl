	partition Presupuesto = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "Presupuesto.csv"),[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Anio", Int64.Type}, {"Mes", Int64.Type}, {"TiendaKey", Int64.Type}, {"Categoria", type text}, {"ValorPresupuesto", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

