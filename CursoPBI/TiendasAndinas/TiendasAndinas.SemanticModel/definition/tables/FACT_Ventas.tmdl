		summarizeBy: none
		sourceColumn: Columna1

		annotation SummarizationSetBy = Automatic

	column 'Margen Linea %' = DIVIDE((FACT_Ventas[precio unit] * (1 - FACT_Ventas[Descuento_Pct])) - FACT_Ventas[CostoUnitario], FACT_Ventas[precio unit] * (1 - FACT_Ventas[Descuento_Pct]))
		dataType: double
		lineageTag: 5940a230-71f3-5447-9338-a6a329525054
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition FACT_Ventas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "FACT_Ventas.csv"),[Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"NumOrden", Int64.Type}, {"LineaOrden", Int64.Type}, {"FechaOrden", type date}, {"FechaEnvio", type date}, {"cust_id", Int64.Type}, {"ProductoKey", Int64.Type}, {"TiendaKey", Int64.Type}, {"Canal", type text}, {"Cantidad", Int64.Type}, {"precio unit", type number}, {"Descuento_Pct", type number}, {"CostoUnitario", type number}, {"ETL_LoadDate", type text}, {"Columna1", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

